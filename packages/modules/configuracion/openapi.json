{
  "security": [
    {
      "BearerToken": []
    }
  ],
  "paths": {
    "/api/v1/personas/consultar": {
      "post": {
        "tags": ["Personas"],
        "operationId": "consultarPersonaPorIdentificacion",
        "summary": "Consultar una persona por cédula",
        "description": "Requiere un administrador global y un token con personas:leer.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["identificacion"],
                "properties": {
                  "identificacion": {"type": "string", "pattern": "^[0-9]{10}$", "description": "Cédula de 10 dígitos", "example": "0920000001"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Datos de identificación y contacto de la persona",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": ["identificacion", "tipo_identificacion", "nombres", "apellidos", "primer_nombre", "segundo_nombre", "primer_apellido", "segundo_apellido", "direccion", "fecha_nacimiento", "email", "telefono", "celular"],
                      "properties": {
                        "identificacion": {"type": "string"},
                        "tipo_identificacion": {"type": "string", "enum": ["cedula"]},
                        "nombres": {"type": "string"},
                        "apellidos": {"type": ["string", "null"]},
                        "primer_nombre": {"type": ["string", "null"]},
                        "segundo_nombre": {"type": ["string", "null"]},
                        "primer_apellido": {"type": ["string", "null"]},
                        "segundo_apellido": {"type": ["string", "null"]},
                        "direccion": {"type": ["string", "null"]},
                        "fecha_nacimiento": {"type": ["string", "null"], "format": "date"},
                        "email": {"type": ["string", "null"]},
                        "telefono": {"type": ["string", "null"]},
                        "celular": {"type": ["string", "null"]}
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {"description": "Token ausente, vencido o inválido"},
          "403": {"description": "La cuenta o el token no tienen el permiso requerido"},
          "404": {"description": "Cédula inexistente"},
          "422": {"description": "Cédula ausente o con formato inválido"},
          "429": {"description": "Límite de solicitudes alcanzado"}
        }
      }
    },
    "/api/v1/usuarios": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "listarUsuarios",
        "summary": "Listar usuarios",
        "description": "Requiere un token de administrador con usuarios:leer. Devuelve hasta 20 registros por página.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Buscar por nombre o correo",
            "schema": {
              "type": "string",
              "maxLength": 160
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listado paginado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuariosPagina"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, vencido o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta o el token no tienen el permiso requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos o correo duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioValidacion"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes alcanzado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/{usuario}": {
      "parameters": [
        {
          "name": "usuario",
          "in": "path",
          "required": true,
          "description": "Identificador del usuario",
          "schema": {
            "type": "integer",
            "minimum": 1
          },
          "example": 4
        }
      ],
      "get": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "consultarUsuario",
        "summary": "Consultar un usuario",
        "description": "Requiere un token de administrador con usuarios:leer.",
        "responses": {
          "200": {
            "description": "Ficha del usuario",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Usuario"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, vencido o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta o el token no tienen el permiso requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "404": {
            "description": "Usuario inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes alcanzado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Usuarios"
        ],
        "operationId": "actualizarUsuario",
        "summary": "Actualizar los datos de un usuario",
        "description": "Requiere un token de administrador con usuarios:escribir. Las cuentas administradoras se editan en Configuración.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsuarioActualizacion"
              },
              "example": {
                "name": "María Rivera",
                "email": "maria@example.test"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "message"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Usuario"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente, vencido o inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "403": {
            "description": "La cuenta o el token no tienen el permiso requerido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "404": {
            "description": "Usuario inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos o correo duplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioValidacion"
                }
              }
            }
          },
          "429": {
            "description": "Límite de solicitudes alcanzado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Usuario": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "is_admin"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "is_admin": {
            "type": "boolean"
          },
            "activo": {
              "type": "boolean",
              "description": "Estado de acceso de la cuenta."
            },
          "nombres": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "apellidos": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "email_contacto": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 255
          },
          "telefono": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "direccion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "celular": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "id_ciudad": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "fecha_nacimiento": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "observacion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 3000
          },
          "urbanizacion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "etapa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "manzana": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "villa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "referencia": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "id_persona": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "UsuarioActualizacion": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "nombres": {
            "type": "string",
            "maxLength": 255
          },
          "apellidos": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "email_contacto": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 255
          },
          "telefono": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "direccion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          },
          "celular": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "id_ciudad": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "fecha_nacimiento": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "observacion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 3000
          },
          "urbanizacion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "etapa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "manzana": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "villa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "referencia": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        },
        "required": [
          "email"
        ],
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "nombres"
            ]
          }
        ]
      },
      "UsuarioError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "UsuarioValidacion": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "UsuariosPagina": {
        "type": "object",
        "required": [
          "data",
          "links",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Usuario"
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "first": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "from": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "last_page": {
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "per_page": {
                "type": "integer"
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
