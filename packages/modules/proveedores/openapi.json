                "properties": {
                    "tipo_identificacion": {
                        "type": "string",
                        "enum": [
                            "cedula",
                            "ruc",
                            "pasaporte"
                        ]
                    },
                    "identificacion": {
                        "type": "string",
                        "maxLength": 30,
                        "description": "Cédula de 10 dígitos, RUC de 13 dígitos o pasaporte alfanumérico con guiones."
                    },
                    "nombre": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                    },
                    "email": {
                        "type": [
                            "string",
