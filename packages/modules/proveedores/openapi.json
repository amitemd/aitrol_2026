                        ],
                        "maxLength": 100
                    },
                    "provincia": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "contactos": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                            "type": "object",
                            "properties": {
                                "nombre": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 120
                                },
                                "cargo": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 80
                                },
                                "email": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "format": "email"
                                },
                                "telefono": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 30
                                }
                            }
                        }
                    },
                    "celular": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "id_ciudad": {
                        "description": "Actualiza la ciudad en personas. Si se omite, se conserva el valor asignado. El valor null elimina la selección.",
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1
                    },
                    "observacion": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 3000
                    },
                    "urbanizacion": {
                        "type": [
                            "string",
