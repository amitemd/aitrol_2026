                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/RespuestaProveedor"
                        },
                        "example": {
                            "data": {
                                "id": 1,
                                "tipo_identificacion": "pasaporte",
                                "identificacion": "DEMO-001",
                                "nombre": "Proveedor de ejemplo",
                                "email": "proveedor@example.test",
                                "telefono": null,
                                "direccion": null,
                                "activo": true
                            }
                        }
                    }
                }
            },
            "ProveedorCreado": {
                "description": "Proveedor registrado.",
                "headers": {
                    "Location": {
                        "schema": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                },
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/RespuestaProveedor"
                        },
                        "example": {
                            "data": {
                                "id": 1,
                                "tipo_identificacion": "pasaporte",
                                "identificacion": "DEMO-001",
                                "nombre": "Proveedor de ejemplo",
                                "email": "proveedor@example.test",
                                "telefono": null,
                                "direccion": null,
                                "activo": true
                            }
                        }
                    }
                }
            },
            "ProveedorNoEncontrado": {
                "description": "Proveedor inexistente.",
