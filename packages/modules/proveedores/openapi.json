                    },
                    "id_persona": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1
                    }
                }
            },
            "DatosProveedor": {
                "type": "object",
                "required": [
                    "tipo_identificacion",
                    "identificacion"
