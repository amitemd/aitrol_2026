                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorApi"
                        }
                    }
                }
            }
        },
        "schemas": {
            "RespuestaProveedor": {
                "type": "object",
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Proveedor"
                    }
                }
            },
            "Proveedor": {
                "type": "object",
                "required": [
                    "id",
                    "tipo_identificacion",
                    "identificacion",
                    "nombre",
                    "activo"
                ],
                "properties": {
                    "tipo_identificacion": {
                        "type": "string",
                        "enum": [
                            "cedula",
                            "ruc",
                            "pasaporte"
                        ]
                    },
                    "identificacion": {
                        "type": "string",
                        "maxLength": 30,
                        "description": "Cédula de 10 dígitos, RUC de 13 dígitos o pasaporte alfanumérico con guiones."
                    },
                    "nombre": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "email": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "email",
                        "maxLength": 254
                    },
                    "telefono": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 30
                    },
                    "direccion": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 255
                    },
                    "activo": {
                        "type": "boolean"
                    },
                    "nombres": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "apellidos": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "ciudad": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "provincia": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "contactos": {
                        "type": "array",
                        "maxItems": 10,
                        "items": {
                            "type": "object",
                            "properties": {
                                "nombre": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 120
                                },
                                "cargo": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 80
                                },
                                "email": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "format": "email"
                                },
                                "telefono": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "maxLength": 30
                                }
                            }
                        }
                    },
                    "celular": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 100
                    },
                    "id_ciudad": {
                        "description": "Ciudad de la persona vinculada al proveedor.",
                        "type": [
