APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
AITROL_REQUIRE_HTTPS=false
# AITROL_TRUSTED_HOSTS=erp.example.com
# AITROL_TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# URL de Ollama accesible desde el servidor de Aitrol.
VICKY_OLLAMA_URL=http://100.106.113.53:11434
VICKY_OLLAMA_MODEL=qwen3.8:27b-q4_K_M
VICKY_OLLAMA_TIMEOUT=60
# MySQL/MariaDB: asignar únicamente SELECT por tabla a las fuentes de config/vicky-reportes.php,
# cb_cuentas y las vistas de cartera habilitadas. Existencias también usa inv_productos e inv_bodegas.
# Evitar permisos globales sobre la base, usuarios, seguridad, sesiones, auditoría y tabla global de personas.
# VICKY_DB_USERNAME=aitrol_vicky_lectura
# VICKY_DB_PASSWORD=
# VICKY_DB_DATABASE=
# Activar solo con una fuente de cartera conciliada: vistas vicky_cartera_cobrar/vicky_cartera_pagar.
# Columnas: id_empresa, tercero, fecha_vencimiento, moneda, saldo_centavos.
VICKY_CARTERA_COBRAR=false
VICKY_CARTERA_PAGAR=false
# Habilitar con la vista vicky_pacientes (id_empresa, codigo, nombre, estado, fecha_registro).
VICKY_PACIENTES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AITROL_EMPRESA_INICIAL=1
AITROL_MANTENIMIENTO_WEB=false
AITROL_MANTENIMIENTO_GIT=false
AITROL_DEPLOY_REMOTO=origin
AITROL_DEPLOY_RAMA=main
# AITROL_PHP_CLI=/usr/bin/php
