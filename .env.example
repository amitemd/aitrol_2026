APP_NAME=AITROL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aitrol
DB_USERNAME=root
DB_PASSWORD=

LEGACY_URL_VARIABLE=
LEGACY_API_URL=
LEGACY_API_TOKEN=
TRUSTED_PROXIES=
FORCE_HTTPS=false
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=
V3_MONITOR_SLOW_MS=2000
V3_MONITOR_SLOW_QUERY_MS=1000
V3_MONITOR_AUDIT_DAYS=7
V3_MONITOR_MIN_DISK_PERCENT=15
V3_MONITOR_MAX_LOG_MB=100
V3_MONITOR_LOG_TAIL_BYTES=1048576
V3_MONITOR_BACKUP_MARKER=
V3_MONITOR_MAX_BACKUP_HOURS=24
DEPLOY_GIT_ENABLED=true
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_BRANCH=main
DEPLOY_GIT_TIMEOUT=300
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

AUTH_LOGIN_PAIR_MAX_ATTEMPTS=5
AUTH_LOGIN_PAIR_DECAY_SECONDS=300
AUTH_LOGIN_ACCOUNT_MAX_ATTEMPTS=10
AUTH_LOGIN_ACCOUNT_DECAY_SECONDS=900
AUTH_LOGIN_IP_MAX_ATTEMPTS=50
AUTH_LOGIN_IP_DECAY_SECONDS=300
AUTH_REMEMBER_DURATION_MINUTES=43200
AUTH_PASSWORD_RESET_PAIR_MAX_ATTEMPTS=3
AUTH_PASSWORD_RESET_PAIR_DECAY_MINUTES=5
AUTH_PASSWORD_RESET_IP_MAX_ATTEMPTS=20
AUTH_PASSWORD_RESET_IP_DECAY_MINUTES=5
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=30
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
