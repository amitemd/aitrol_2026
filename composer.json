{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "google/apiclient": "^2.20",
        "intervention/image-laravel": "^4.1",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "milon/barcode": "^13.5",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "phpoffice/phpspreadsheet": "^5.10",
        "predis/predis": "^3.0",
        "rdx/laravelcollective-html": "^6.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Maatwebsite\\Excel\\Facades\\": "app/Compatibility/Maatwebsite/Excel/Facades/",
            "Sis_medico\\": "app/Legacy/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "app/Legacy/"
        ],
        "exclude-from-classmap": [
            "app/Legacy/Ct_Balances copy.php",
            "app/Legacy/EstadoResultado200123.php",
            "app/Legacy/Http/Controllers/archivo_plano/ApPlantillaControllerItem.php",
            "app/Legacy/Http/Controllers/CierreCajaController.php",
            "app/Legacy/Http/Controllers/contable/ListaCiudadesController.php",
            "app/Legacy/Http/Controllers/EgresoAcreedorController.php",
            "app/Legacy/Http/Controllers/excelCreate_.php",
            "app/Legacy/Http/Controllers/guia/original/",
            "app/Legacy/Http/Controllers/auditoria_hc_admision/ConsultaController.php",
            "app/Legacy/Http/Controllers/contable/ProductoController.php",
            "app/Legacy/Http/Controllers/hospital/ProveedorController.php",
            "app/Legacy/Http/Controllers/plantilla_labs/KardexController_.php",
            "app/Legacy/Http/Controllers/plantilla_labs/PlantillaControlLabsController copy.php",
            "app/Legacy/Http/Controllers/PrecioProductoController.php",
            "app/Legacy/Http/Controllers/servicios/ServiciosKController.php",
            "app/Legacy/Http/Controllers/Insumos/InvCabTomaFisica.php",
            "app/Legacy/Http/Controllers/Insumos/InvContableCab.php",
            "app/Legacy/Http/Controllers/Insumos/InvDetTomaFisica.php",
            "app/Legacy/Http/Controllers/Insumos/InvDetTomaFisicaLog.php",
            "app/Legacy/Http/Controllers/servicios/Log_Apps.php",
            "app/Legacy/v3/contable/NotaCreditom.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
